# Live AI itineraries (keep this key on the backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: persist generated itineraries in Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated frontend origins for production, e.g. https://your-site.netlify.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
