# Copy this file to .env and fill in real values.
# Never commit .env.

# Required for live AI itineraries (Google AI Studio):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional. If either value is missing, itineraries are generated
# but not saved. Use the service role key on the backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
